# Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID of type "Desktop app".
# Restrict the consent screen / Workspace to Alpha School if you can.
# Never commit the real values. GitHub Actions reads these from repository secrets.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Desktop clients include a client secret. It is not a server secret —
# electron-builder bakes it into the Mac app at release time if you set it.
GOOGLE_CLIENT_SECRET=

# Unpackaged local testing only. Must be @alpha.school or @founders.school.
# Ignored in packaged CreateMeter.app builds.
# CREATEMETER_DEV_USER=you@alpha.school
